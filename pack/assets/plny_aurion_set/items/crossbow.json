{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:charge_type",
    "cases": [
      {
        "when": "arrow",
        "model": {"type": "minecraft:model", "model": "plny_aurion_set:item/crossbow_charged"}
      },
      {
        "when": "rocket",
        "model": {"type": "minecraft:model", "model": "plny_aurion_set:item/crossbow_firework"}
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:crossbow/pull",
        "fallback": {"type": "minecraft:model", "model": "plny_aurion_set:item/crossbow_0"},
        "entries": [
          {"threshold": 0.58, "model": {"type": "minecraft:model", "model": "plny_aurion_set:item/crossbow_1"}},
          {"threshold": 1.0, "model": {"type": "minecraft:model", "model": "plny_aurion_set:item/crossbow_2"}}
        ]
      },
      "on_false": {"type": "minecraft:model", "model": "plny_aurion_set:item/crossbow"}
    }
  }
}